      ],
      "pinStyles": {
        "P0": "croc",
        "P1": "croc",
        "P2": "croc",
        "GND": "croc",
        "+3v3": "croc"
      },
      "marginWhenBreadboarding": [0, 0, 80, 0]
    }
  },
  "serial": {
    "nameFilter": "^(mbed Serial Port|DAPLink CMSIS-DAP)",
