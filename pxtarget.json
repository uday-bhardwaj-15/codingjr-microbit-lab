      },
      "analogInPins": ["P0", "P1", "P2", "P3", "P10"],
      "groundPins": ["GND"],
      "threeVoltPins": ["+3v3"],
      "attachPowerOnRight": true,
      "onboardComponents": [
        "accelerometer",
        "buttonpair",
        "ledmatrix",
        "speaker",
        "bluetooth",
        "thermometer",
        "compass",
        "builtinspeaker",
        "microphone",
        "logotouch",
        "flashlog",
